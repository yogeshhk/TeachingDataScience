{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\check-em-dash.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "Checking for em-dashes..."
          }
        ]
      }
    ]
  }
}
